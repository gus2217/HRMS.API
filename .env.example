# Copy to .env and adjust as needed. Used by docker-compose.yml (Redis/MinIO/OTel only).
# Postgres is EXTERNAL — point dev.sh at your server via these vars:
#   DB_HOST=your-postgres-host
#   DB_PORT=5432
#   DB_NAME=jacana_hrms
#   DB_USER=jacana
#   DB_PASS=your-password

# MinIO (media/attachments object storage) — matches appsettings Storage:Minio.
# If you change these, set the matching Storage__Minio__* vars for the API too.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
# Storage__Provider=Minio
# Storage__Minio__Endpoint=localhost:9000
# Storage__Minio__AccessKey=minioadmin
# Storage__Minio__SecretKey=minioadmin
# Storage__Minio__Bucket=jacana-media
